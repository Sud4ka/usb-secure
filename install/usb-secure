#!/bin/bash

APP="/home/sud4k/Descargas/USB_Secure"

if [ ! -f "$APP" ]; then
    notify-send "USB Secure" "Error: no se encuentra $APP" -i dialog-error
    exit 1
fi

# NOPASSWD: solo pasar DISPLAY, evitar -E porque sudo bloquea WAYLAND_DISPLAY etc
if sudo -n true 2>/dev/null; then
    exec sudo DISPLAY="$DISPLAY" "$APP" "$@"
fi

# Pedir contraseña en terminal
exec xterm -geometry 80x12 -title "USB Secure" -hold -e sudo DISPLAY="$DISPLAY" "$APP"
