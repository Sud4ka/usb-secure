#!/bin/bash

APP="/usr/local/bin/USB_Secure"

if [ ! -f "$APP" ]; then
    notify-send "USB Secure" "Error: no se encuentra $APP" -i dialog-error
    exit 1
fi

DISPLAY="${DISPLAY:-:0}"

# NOPASSWD
if sudo -n true 2>/dev/null; then
    sudo DISPLAY="$DISPLAY" "$APP" "$@" &
    disown
    exit 0
fi

# Pedir contraseña en terminal (desacoplado del lanzador)
xterm -geometry 80x12 -title "USB Secure" -hold \
    -e "sudo DISPLAY='$DISPLAY' '$APP'" &
disown
exit 0
