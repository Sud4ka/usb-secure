#!/bin/bash

APP="/home/sud4k/Descargas/USB_Secure"

if [ ! -f "$APP" ]; then
    notify-send "USB Secure" "Error: no se encuentra $APP" -i dialog-error
    exit 1
fi

# Strip env vars that sudo blocks, they're not needed by Tkinter/X11 anyway
unset WAYLAND_DISPLAY XDG_RUNTIME_DIR

# NOPASSWD path
if sudo -n true 2>/dev/null; then
    exec sudo -E "$APP" "$@"
fi

# Pedir contraseña en terminal
exec xterm -geometry 80x12 -title "USB Secure" -hold -e sudo -E "$APP"
